#!/bin/sh
# vlicx-fi — Open a file in Vlicx editor with stylish update check
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

VERSION_FILE="$HOME/.vlicx-version"
if [ -f "$VERSION_FILE" ] && command -v curl >/dev/null 2>&1; then
    LOCAL_SHA=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '\r\n ')
    REMOTE_SHA=$(curl -s -m 2 "https://api.github.com/repos/cortane/Vlicx-Editor/commits/main" | grep '"sha"' | head -n 1 | cut -d '"' -f 4 || true)
    if [ -n "$REMOTE_SHA" ] && [ -n "$LOCAL_SHA" ] && [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
        printf "\033[1;33m╭──────────────────────────────────────────────────────────────────────────────╮\033[0m\n"
        printf "\033[1;33m│ 💡 VlicxEditor に最新バージョンの更新があります！                              │\033[0m\n"
        printf "\033[1;33m│   更新コマンド:                                                              │\033[0m\n"
        printf "\033[1;36m│   curl -fsSL https://raw.githubusercontent.com/cortane/Vlicx-Editor/main/install.sh | sh │\033[0m\n"
        printf "\033[1;33m╰──────────────────────────────────────────────────────────────────────────────╯\033[0m\n"
        sleep 1
    fi
fi

if [ -x "$SCRIPT_DIR/vlicx" ]; then
    exec "$SCRIPT_DIR/vlicx" --mode file "$@"
elif [ -x "$SCRIPT_DIR/../vlicx" ]; then
    exec "$SCRIPT_DIR/../vlicx" --mode file "$@"
else
    exec vlicx --mode file "$@"
fi
