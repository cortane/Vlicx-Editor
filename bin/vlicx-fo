#!/bin/sh
# vlicx-fo — Open a folder in Vlicx editor with stylish update check
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"

VERSION_FILE="$HOME/.vlicx-version"
if [ -f "$VERSION_FILE" ] && command -v curl >/dev/null 2>&1; then
    LOCAL_SHA=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '\r\n ')
    REMOTE_SHA=$(curl -s -m 2 "https://api.github.com/repos/cortane/Vlicx-Editor/commits/main" | grep '"sha"' | head -n 1 | cut -d '"' -f 4 || true)
    if [ -n "$REMOTE_SHA" ] && [ -n "$LOCAL_SHA" ] && [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
        printf "\033[1;33m[UPDATE] Vlicx Editor の最新バージョンが利用可能です。\033[0m\n"
        printf "\033[1;37m更新コマンド: \033[1;36mcurl -fsSL https://raw.githubusercontent.com/cortane/Vlicx-Editor/main/install.sh | sh\033[0m\n\n"
        sleep 1
    fi
fi

if [ -x "$SCRIPT_DIR/vlicx" ]; then
    exec "$SCRIPT_DIR/vlicx" --mode folder "$@"
elif [ -x "$SCRIPT_DIR/../vlicx" ]; then
    exec "$SCRIPT_DIR/../vlicx" --mode folder "$@"
else
    exec vlicx --mode folder "$@"
fi
