#!/bin/sh
# Vlicx Editor — Alpine Linux Login Update Banner Check
VERSION_FILE="$HOME/.vlicx-version"
if [ -f "$VERSION_FILE" ] && command -v curl >/dev/null 2>&1; then
    LOCAL_SHA=$(cat "$VERSION_FILE" 2>/dev/null | tr -d '\r\n ')
    REMOTE_SHA=$(curl -s -m 2 "https://api.github.com/repos/cortane/Vlicx-Editor/commits/main" | grep '"sha"' | head -n 1 | cut -d '"' -f 4 || true)
    if [ -n "$REMOTE_SHA" ] && [ -n "$LOCAL_SHA" ] && [ "$LOCAL_SHA" != "$REMOTE_SHA" ]; then
        printf "\n\033[1;33m+----------------------------------------------------------+\033[0m\n"
        printf "\033[1;33m|\033[0m  \033[1;36mVlicx Editor の最新アップデートが利用可能です！\033[0m         \033[1;33m|\033[0m\n"
        printf "\033[1;33m|\033[0m  更新を実行するには \033[1;32mvlicx-upd\033[0m と入力してください   \033[1;33m|\033[0m\n"
        printf "\033[1;33m+----------------------------------------------------------+\033[0m\n\n"
    fi
fi
